# Email Configuration
# Copy this file to .env and fill in your actual values

# EmailJS Configuration (Recommended for simple setup)
# Get these values from https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# SMTP Configuration (Alternative option)
# Use these if you prefer direct SMTP with a backend service
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=your-email@gmail.com
VITE_SMTP_PASS=your-app-password

# Recipient Email
VITE_RECIPIENT_EMAIL=davidjones@gmail.com

# Formspree Configuration (Alternative option)
# Get this from https://formspree.io/
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
